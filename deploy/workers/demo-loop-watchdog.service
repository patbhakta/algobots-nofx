# Demo-loop watchdog (ALG-3357): guards the Kalshi paper demo end-to-end.
# Feed freshness + worker health every 5 min; auto-posts the daily-loss
# envelope day-reset fill proof to ALG-3357 after 00:00 UTC. Anti-spam:
# one alert per anomaly episode, re-alert at 6h, one proof per UTC day.
# Install on .243:
#   cp /opt/algobots/repo/deploy/workers/demo-loop-watchdog.* /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now demo-loop-watchdog.timer
[Unit]
Description=AlgoBots Kalshi demo-loop watchdog (feed+workers, paper only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/algobots/repo/src/algobots/demo/loop_watchdog.py
# loop_watchdog writes its own log/state under the feed dir; keep journald quiet
StandardOutput=journal
StandardError=journal
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/laya/kalshi
ProtectHome=read-only
PrivateTmp=yes
