# AlgoBots docker-compose environment (copy to deploy/.env and adjust)
POSTGRES_USER=algobots
POSTGRES_PASSWORD=change-me
POSTGRES_DB=algobots
# Host interface/port the API publishes on (bhakta VPS: tailnet IP, 8190 —
# 127.0.0.1:8000 is taken by huible-app).
API_BIND=127.0.0.1
API_PORT=8000
# Control-plane secrets — generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ALGOBOTS_JWT_SECRET=change-me-32-bytes-minimum
# Fernet key for account credentials: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ALGOBOTS_CREDENTIAL_ENCRYPTION_KEY=
