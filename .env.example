# compose.yaml environment (ROADMAP-v3 Phase 0). Copy to `.env` and fill in.
# Secrets come from the environment or the encrypted store, never the repo
# (roadmap rule 3) — the two required values below have no defaults, so a bare
# `docker compose up` fails closed instead of starting with a known password.

# --- required ---------------------------------------------------------------
POSTGRES_PASSWORD=
NOFX_JWT_SECRET=

# --- NoFX database: sqlite until the guarded cutover ------------------------
# Leave this alone. `postgres` is valid ONLY after
# scripts/migrate-nofx-sqlite.sh has produced a verification report against a
# copy of the live data.db; flipping it early points NoFX at an empty database
# and locks every existing member out.
NOFX_DB_TYPE=sqlite

# --- host paths (defaults are the live `.243` layout, see INVENTORY.md) -----
NOFX_DATA_DIR=/opt/algobots-stack/data
BRIDGE_DIR=/opt/algobots-stack/bridge
NOFX_BRIDGE_DIR=/opt/algobots-stack/bridge
KALSHI_FEED_DIR=/opt/laya/kalshi
NAUTILUS_WORK_DIR=/mnt/funnytree/algobots

# --- optional overrides -----------------------------------------------------
POSTGRES_USER=algobots
POSTGRES_DB=algobots
NOFX_DB=nofx
# Published ports bind to the Tailscale address on `.243`; localhost in dev.
TAILNET_BIND=127.0.0.1
API_BIND=127.0.0.1
API_PORT=8000
NOFX_PORT=8200
NOFX_FRONTEND_PORT=8201
NAUTILUS_PORT=8202
